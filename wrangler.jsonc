// Configuración del Worker de GeoCR en Cloudflare (se publica solo con cada cambio en GitHub).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geocr",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Todo pasa primero por el Worker, para exigir la entrada (correo autorizado) también en la página.
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "geocr", "database_id": "9646f472-45f2-4067-9199-6eb180434db0" }
  ],
  // Conserva las variables puestas en el panel (EDITORES); los secrets (INGEST_TOKEN) se conservan siempre.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Cada hora: flota John Deere; a las 10:00 y 18:00 UTC (6 a. m. y 2 p. m. RD) también el robot NAX. Respaldos del robot a las 11:30 y 19:30 UTC.
  "triggers": { "crons": ["0 * * * *", "30 11 * * *", "30 19 * * *"] }
}
